<UserControl x:Class="UI.Components.LogsData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Components"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid>
        <DataGrid Name="logsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="4" MouseDoubleClick="OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Logs" Binding="{Binding Timestamp, StringFormat=G}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
